# ==============================================================================
# Trinetra Environment Configuration Reference
# ==============================================================================

# --- Database Configuration ---
# Supported engines: SQLite (sqlite:///path) or PostgreSQL (postgresql+psycopg://user:pass@host:5432/dbname)
TRINETRA_DATABASE_URL=sqlite:////data/trinetra.db
TRINETRA_AUTO_CREATE_SCHEMA=true

# --- Security & Authentication ---
# Secret key used for signing JWT access tokens (generate with `openssl rand -hex 32`)
TRINETRA_JWT_SECRET=replace-with-a-secure-random-secret-key-in-production

# Allowed CORS origins for the API server (comma-separated)
TRINETRA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting per IP per minute
TRINETRA_RATE_LIMIT_PER_MINUTE=120

# Optional shared bearer token for authenticating scanner agent callbacks
TRINETRA_SCANNER_TOKEN=

# --- Initial Admin Bootstrap ---
# Automatically creates the first tenant admin user if not present
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=adminpassword
BOOTSTRAP_TENANT_ID=default
BOOTSTRAP_PROJECT_NAME=Default project

# --- Storage & Artifact Paths ---
# Directory where generated compliance export documents (PDF, Excel, SARIF) are stored
TRINETRA_REPORT_STORE=/data/reports

# Directory where raw uploaded/scanned CBOM artefacts and cache keys are stored
TRINETRA_ARTIFACT_STORE=/artifact-store

# --- Distributed Asynchronous Queue (Celery & Redis) ---
TRINETRA_CELERY_BROKER_URL=redis://redis:6379/0
TRINETRA_CELERY_RESULT_BACKEND=redis://redis:6379/0

# Worker process concurrency (number of parallel scan tasks)
TRINETRA_WORKER_CONCURRENCY=4

# Task execution timeouts (in seconds)
TRINETRA_TASK_TIME_LIMIT=3600
TRINETRA_TASK_SOFT_TIME_LIMIT=3300

# --- External Scanner Microservice Gateways (Optional) ---
# TRINETRA_SCANNER_SOURCE_URL=http://scanner-source:8001
# TRINETRA_SCANNER_CONTAINER_URL=http://scanner-container:8002
# TRINETRA_SCANNER_CLOUD_URL=http://scanner-cloud:8003
# TRINETRA_SCANNER_DEPENDENCY_URL=http://scanner-dependency:8004
# TRINETRA_SCANNER_NETWORK_URL=http://scanner-network:8005
